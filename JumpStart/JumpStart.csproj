<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Package Properties -->
    <PackageId>JumpStart</PackageId>
    <Version>1.0.0</Version>
    <Authors>Scott Blomfield</Authors>
    <Company>JumpStart</Company>
    <Description>A Blazor framework providing entity base classes, repository pattern implementation, and audit tracking for rapid application development.</Description>
    <PackageTags>blazor;entity-framework;repository;audit;framework</PackageTags>
    <PackageProjectUrl>https://github.com/cyberknet/JumpStart</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cyberknet/JumpStart</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>JumpStart</Title>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="Correlate.AspNetCore" Version="6.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Refit" Version="15.2.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="15.2.0" />
    <!-- Refit 15 split the old runtime-reflection-based client generator out of the core package in
         favor of defaulting toward compile-time source generation - AddRefitClient<T>/AddApiClient<T>
         below still use the reflection path, and without this throws NotSupportedException the first
         time a client is actually resolved (confirmed live: RustArchon.Panel 500'd on its very first
         page load after the Refit 13->15 bump, since App.razor's own component tree resolves one via
         DI immediately). Migrating every Refit interface in this codebase to the source-generated
         model instead is a real option later, but out of scope for a package-version bump. -->
    <PackageReference Include="Refit.Reflection" Version="15.2.0" />
    <PackageReference Include="RestEase" Version="1.6.4" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>
</Project>
