@using JumpStart.Data
@using JumpStart.Services
@using Microsoft.AspNetCore.Components.Routing
@inject ITenantSelectionService TenantSelection
@inject NavigationManager Navigation
@implements IDisposable

<div class="tenant-switcher">
    @if (_availableTenants.Count > 1)
    {
        <div class="tenant-dropdown">
            <label for="tenant-select" class="tenant-label">Organization:</label>
            @* Uses @bind:get/@bind:set rather than a manual value="@_currentTenantId" @onchange="..."
               pair - confirmed by tracing (live DOM inspection plus the compiled DLL's string table)
               that on this project's current preview .NET SDK, the manual pair silently fails to
               compile into a real attribute/event handler on this <select> - it comes out as a
               literal, inert "@onchange" text attribute instead, so picking a different option never
               invokes any C# code at all. @bind:get/@bind:set takes the well-tested compiler path and
               still lets OnTenantChanged run the same async side effects (API call, navigation). *@
            <select id="tenant-select"
                    class="tenant-select"
                    @bind:get="_currentTenantId"
                    @bind:set="OnTenantChanged">
                @foreach (var tenant in _availableTenants)
                {
                    <option value="@tenant.Id">@tenant.Name</option>
                }
            </select>
        </div>
    }
    else if (_availableTenants.Count == 1)
    {
        <div class="tenant-display">
            <span class="tenant-label">Organization:</span>
            <span class="tenant-name">@_availableTenants[0].Name</span>
        </div>
    }
</div>

@code {
    private List<Tenant> _availableTenants = new();
    private Guid _currentTenantId;

    /// <summary>
    /// If true, reloads the entire page when the tenant changes. Default is true to ensure all data is refreshed with the new tenant context.
    /// </summary>
    [Parameter]
    public bool ReloadOnChange { get; set; } = true;

    /// <summary>
    /// The URL to navigate to after a tenant change. Default is "/" (home page).
    /// </summary>
    [Parameter]
    public string NavigateToUrl { get; set; } = "/";

    /// <summary>
    /// Event callback invoked when the tenant changes. The callback receives the new tenant's Guid.
    /// </summary>
    [Parameter]
    public EventCallback<Guid> OnTenantChangedCallback { get; set; }

    /// <summary>
    /// Called by the Blazor framework when the component is initialized. Subscribes to tenant change events and loads available tenants.
    /// </summary>
    /// <returns>A task representing the asynchronous operation.</returns>
    protected override async Task OnInitializedAsync()
    {
        TenantSelection.TenantChanged += HandleTenantChanged;
        TenantSelection.AvailableTenantsChanged += HandleAvailableTenantsChanged;
        Navigation.LocationChanged += HandleLocationChanged;
        await LoadTenantsAsync();
    }

    /// <summary>
    /// Loads the list of available tenants and sets the current tenant.
    /// </summary>
    /// <returns>A task representing the asynchronous operation.</returns>
    private async Task LoadTenantsAsync()
    {
        _availableTenants = await TenantSelection.GetAvailableTenantsAsync();
        
        var currentTenant = await TenantSelection.GetCurrentTenantAsync();
        _currentTenantId = currentTenant?.Id ?? (_availableTenants.FirstOrDefault()?.Id ?? Guid.Empty);
    }

    /// <summary>
    /// Handles the tenant selection change event from the dropdown.
    /// Sets the current tenant, invokes the callback, and reloads the page if configured.
    /// </summary>
    /// <param name="tenantId">The newly selected tenant's Guid, already parsed by the framework's
    /// <c>@bind:set</c> binding (see the &lt;select&gt; markup above's remarks for why this replaced
    /// a plain <c>value</c>/<c>@onchange</c> pair).</param>
    /// <returns>A task representing the asynchronous operation.</returns>
    private async Task OnTenantChanged(Guid tenantId)
    {
        var success = await TenantSelection.SetCurrentTenantAsync(tenantId);

        if (success)
        {
            _currentTenantId = tenantId;

            // Invoke callback if provided
            if (OnTenantChangedCallback.HasDelegate)
            {
                await OnTenantChangedCallback.InvokeAsync(tenantId);
            }

            // Reload page to refresh all data with new tenant context. The tenant id rides along
            // in the URL because the reload tears down this whole circuit - including whatever
            // in-memory selection TenantSelection.SetCurrentTenantAsync just recorded - so the
            // fresh circuit's ITenantSelectionService has no other way to know what was just
            // chosen. See ITenantSelectionService.TenantIdQueryParameterName's remarks.
            if (ReloadOnChange)
            {
                var separator = NavigateToUrl.Contains('?') ? '&' : '?';
                Navigation.NavigateTo(
                    $"{NavigateToUrl}{separator}{ITenantSelectionService.TenantIdQueryParameterName}={tenantId}",
                    forceLoad: true);
            }
        }
    }

    /// <summary>
    /// Handles the tenant changed event from the tenant selection service.
    /// Updates the current tenant and triggers a UI refresh.
    /// </summary>
    /// <param name="tenantId">The new tenant's Guid, or null if none.</param>
    private void HandleTenantChanged(Guid? tenantId)
    {
        if (tenantId.HasValue)
        {
            _currentTenantId = tenantId.Value;
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Re-fetches the tenant list on every navigation, so an edit made to a tenant's own record - its
    /// name, most visibly - is reflected here the next time the user goes anywhere, not left stale for
    /// the rest of the circuit's life.
    /// </summary>
    /// <remarks>
    /// <para>
    /// This component is mounted once in the host app's layout (e.g. <c>MainLayout</c>) with its own
    /// explicit <c>@rendermode</c>, so - unlike a normal page component - it survives every in-app
    /// navigation for as long as the circuit lives; <see cref="LoadTenantsAsync"/> otherwise runs
    /// exactly once, in <see cref="OnInitializedAsync"/>, and never again. There is no cross-component
    /// event for "a tenant's own data changed" the way <see cref="ITenantSelectionService.TenantChanged"/>
    /// exists for "the selection changed" - adding one would mean plumbing a new event through every
    /// <see cref="ITenantSelectionService"/> implementation and, per <c>CircuitServicesAccessor.Services</c>'s
    /// remarks, a cross-DI-scope-safe way to raise it. Reacting to navigation instead needs neither:
    /// <see cref="NavigationManager"/> is itself circuit-wide already, and "the user went somewhere"
    /// is a good-enough proxy for "whatever might have changed since the list was last loaded" - the
    /// extra query this adds is one scoped to the caller's own handful of tenant memberships.
    /// </para>
    /// <para>
    /// Blazor's <c>InteractiveServer</c> event dispatch is already properly synchronized - see
    /// <see cref="HandleTenantChanged"/>'s identical <see cref="InvokeAsync{TResult}"/> use - so this
    /// does not skip a render even though <see cref="NavigationManager.LocationChanged"/> is not itself
    /// a Blazor lifecycle callback.
    /// </para>
    /// </remarks>
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(async () =>
        {
            await LoadTenantsAsync();
            StateHasChanged();
        });

    /// <summary>
    /// Refreshes immediately when <see cref="ITenantSelectionService.RefreshAvailableTenantsAsync"/>
    /// was called on <em>this same instance</em> - the common case being a page that (like this
    /// component) does not declare its own <c>@rendermode</c> and so shares this component's DI scope,
    /// or a caller that happens to have been resolved from the same scope some other way. A page that
    /// declares its own explicit <c>@rendermode</c> - the more common shape in this app, and why
    /// <see cref="HandleLocationChanged"/> above exists at all - is a different island with its own
    /// separate instance and will not raise this event on this one; that gap is what the
    /// navigation-triggered refresh covers instead.
    /// </summary>
    private void HandleAvailableTenantsChanged() =>
        InvokeAsync(async () =>
        {
            await LoadTenantsAsync();
            StateHasChanged();
        });

    /// <summary>
    /// Disposes the component and unsubscribes from tenant change events.
    /// </summary>
    public void Dispose()
    {
        TenantSelection.TenantChanged -= HandleTenantChanged;
        TenantSelection.AvailableTenantsChanged -= HandleAvailableTenantsChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}

<style>
    .tenant-switcher {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem;
    }

    .tenant-dropdown, .tenant-display {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .tenant-label {
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--text-secondary, #6b7280);
    }

    .tenant-select {
        padding: 0.375rem 0.75rem;
        border: 1px solid var(--border-color, #d1d5db);
        border-radius: 0.375rem;
        font-size: 0.875rem;
        background-color: var(--background, white);
        color: var(--text-primary, #111827);
        cursor: pointer;
    }

    .tenant-select:hover {
        border-color: var(--border-hover, #9ca3af);
    }

    .tenant-select:focus {
        outline: 2px solid var(--focus-color, #3b82f6);
        outline-offset: 2px;
    }

    .tenant-name {
        font-weight: 500;
        font-size: 0.875rem;
        color: var(--text-primary, #111827);
    }
</style>
